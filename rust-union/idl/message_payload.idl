// The union of GitHub #33 as the reporter wrote it: the discriminator has
// four values, and two of them select no member.
@final
struct Vec3F32 {
    float x;
    float y;
    float z;
};

@final
enum MessagePayloadDiscriminator {
    @value(0)
    MESSAGE_PAYLOAD_DISCRIMINATOR_POSITION,
    MESSAGE_PAYLOAD_DISCRIMINATOR_VELOCITY,
    MESSAGE_PAYLOAD_DISCRIMINATOR_HEARTBEAT,
    MESSAGE_PAYLOAD_DISCRIMINATOR_ACKNOWLEDGEMENT
};

@final
union MessagePayload switch (MessagePayloadDiscriminator) {
    case MESSAGE_PAYLOAD_DISCRIMINATOR_POSITION:
        Vec3F32 position;
    case MESSAGE_PAYLOAD_DISCRIMINATOR_VELOCITY:
        Vec3F32 velocity;
};
