// ../dyn_app.idl for OpenDDS's IDL compiler, with two differences:
//
// * `@topic` on Track: without it opendds_idl generates no TrackTypeSupport.
// * `@must_understand` on the key member, which XTypes 1.3 §7.2.2.4.4.4.8
//   makes implicit and ZeroDDS sets without being told; opendds_idl 3.34
//   sets IS_MUST_UNDERSTAND only when it is written, and a minimal
//   TypeObject without it hashes differently from ZeroDDS's. OpenDDS 3.34
//   reads a remote reader's ALLOW_TYPE_COERCION as DISALLOW and then
//   matches identical type identifiers only. See
//   ../../cross-vendor-rich/opendds/Rich.idl.
module dyn {
  enum Color { RED, GREEN, BLUE };
  @appendable union Cmd switch(long) {
    case 1: long    speed;
    case 2: double  angle;
    default: octet  flag;
  };
  @topic
  @appendable struct Track {
    @key @must_understand long id;
    string          name;
    Color           hue;
    sequence<long>  path;
    Cmd             command;
  };
};
