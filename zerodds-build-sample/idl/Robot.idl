#include "Pose.idl"

struct Unit {
    long id;
    geometry::Pose pose;
};

// Cyclone/OpenSplice/RTI pragma spelling of `@key` — proves the
// zerodds-build pipeline (zerodds-idl-compose) applies vendor
// key-pragmas, not just OMG-IDL-4.2 `@key` annotations. A build.rs that
// called the parser and an emitter directly (the ad hoc pattern
// zerodds-build replaces) never saw this.
#pragma keylist Unit id
