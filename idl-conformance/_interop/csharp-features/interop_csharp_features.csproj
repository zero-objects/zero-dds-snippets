<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>LatestMajor</RollForward>
    <AssemblyName>interop-csharp-features</AssemblyName>
    <NoWarn>CS0168;CS8019;CS8632;CS0219</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- ZeroDDS brings ZeroDDS.Cdr (IDdsTopicType, Omg.Types) and
         runtime/csharp (ZeroDds.Wire), the two the generated code names. -->
    <ProjectReference Include="../../../../crates/cs/csharp/ZeroDDS/ZeroDDS.csproj" />
  </ItemGroup>
</Project>
