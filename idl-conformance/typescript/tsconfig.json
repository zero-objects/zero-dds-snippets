{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "typeRoots": ["../../../crates/ts-node/node_modules/@types"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@zerodds/node": ["../../../crates/ts-node/dist/index.d.ts"],
      "@zerodds/wire": ["../../../runtime/typescript/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*", "gen/**/*"]
}
