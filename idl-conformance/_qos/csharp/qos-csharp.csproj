<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>LatestMajor</RollForward>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>qos-conformance-csharp</AssemblyName>
    <NativeLibraryDirectory Condition="'$(NativeLibraryDirectory)' == ''">$(MSBuildThisFileDirectory)../../../../target/debug</NativeLibraryDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../crates/cs/csharp/ZeroDDS/ZeroDDS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="reading.idl" />
  </ItemGroup>

  <!-- macOS SIP strips DYLD_LIBRARY_PATH from the dotnet host, so the native
       libzerodds.dylib (already built by the workspace) is copied next to the
       managed assembly where the P/Invoke loader will find it. -->
  <ItemGroup>
    <None Include="$(NativeLibraryDirectory)/libzerodds.dylib"
          Condition="Exists('$(NativeLibraryDirectory)/libzerodds.dylib')">
      <Link>libzerodds.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(NativeLibraryDirectory)/libzerodds.so"
          Condition="Exists('$(NativeLibraryDirectory)/libzerodds.so')">
      <Link>libzerodds.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(NativeLibraryDirectory)/zerodds.dll"
          Condition="Exists('$(NativeLibraryDirectory)/zerodds.dll')">
      <Link>zerodds.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
